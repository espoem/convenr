      "checkConstraints": {
        "events_days_match_mode": {
          "name": "events_days_match_mode",
          "value": "case \"events\".\"day_mode\"\n        when 'range' then \"events\".\"range_first\" is not null and \"events\".\"range_last\" is not null\n          and \"events\".\"dates\" is null and \"events\".\"weekdays\" is null\n        when 'dates' then \"events\".\"dates\" is not null\n          and \"events\".\"range_first\" is null and \"events\".\"range_last\" is null and \"events\".\"weekdays\" is null\n        else \"events\".\"weekdays\" is not null\n          and \"events\".\"range_first\" is null and \"events\".\"range_last\" is null and \"events\".\"dates\" is null\n      end"
        },
        "events_daily_range": {
          "name": "events_daily_range",
          "value": "\"events\".\"daily_start\" >= 0 and \"events\".\"daily_end\" <= 1440 and \"events\".\"daily_start\" < \"events\".\"daily_end\""
        },
        "events_slot_length": {
          "name": "events_slot_length",
          "value": "\"events\".\"slot_length\" in (15, 30, 60)"
        },
        "events_first_day_of_week": {
          "name": "events_first_day_of_week",
          "value": "\"events\".\"first_day_of_week\" between 1 and 7"
        }
      },
