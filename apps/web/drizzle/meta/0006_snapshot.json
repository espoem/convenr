      "checkConstraints": {
        "events_schedule_matches_kind": {
          "name": "events_schedule_matches_kind",
          "value": "case \"events\".\"kind\"\n        when 'poll' then \"events\".\"day_mode\" is null and \"events\".\"range_first\" is null\n          and \"events\".\"range_last\" is null and \"events\".\"dates\" is null and \"events\".\"weekdays\" is null\n          and \"events\".\"daily_start\" is null and \"events\".\"daily_end\" is null\n          and \"events\".\"slot_length\" is null and \"events\".\"first_day_of_week\" is null\n        when 'grid' then \"events\".\"daily_start\" is not null and \"events\".\"daily_end\" is not null\n          and \"events\".\"slot_length\" is not null and \"events\".\"first_day_of_week\" is not null\n          and case \"events\".\"day_mode\"\n            when 'range' then \"events\".\"range_first\" is not null and \"events\".\"range_last\" is not null\n              and \"events\".\"dates\" is null and \"events\".\"weekdays\" is null\n            when 'dates' then \"events\".\"dates\" is not null\n              and \"events\".\"range_first\" is null and \"events\".\"range_last\" is null and \"events\".\"weekdays\" is null\n            when 'weekdays' then \"events\".\"weekdays\" is not null\n              and \"events\".\"range_first\" is null and \"events\".\"range_last\" is null and \"events\".\"dates\" is null\n            else false\n          end\n        else false\n      end"
        },
        "events_daily_range": {
          "name": "events_daily_range",
          "value": "\"events\".\"daily_start\" >= 0 and \"events\".\"daily_end\" <= 1440 and \"events\".\"daily_start\" < \"events\".\"daily_end\""
        },
        "events_slot_length": {
          "name": "events_slot_length",
          "value": "\"events\".\"slot_length\" in (15, 30, 60)"
        },
        "events_first_day_of_week": {
          "name": "events_first_day_of_week",
          "value": "\"events\".\"first_day_of_week\" between 1 and 7"
        },
        "events_final": {
          "name": "events_final",
          "value": "case \"events\".\"final_state\"\n        when 'open' then \"events\".\"final_start\" is null and \"events\".\"final_end\" is null\n        when 'chosen' then \"events\".\"final_start\" is not null and \"events\".\"final_end\" is not null\n          and \"events\".\"final_start\" < \"events\".\"final_end\"\n        else false\n      end"
        },
        "events_final_sequence": {
          "name": "events_final_sequence",
          "value": "\"events\".\"final_sequence\" >= 0"
        }
      },
