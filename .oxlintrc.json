{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true,
		"typeCheck": true
	},
	"plugins": ["typescript", "unicorn", "oxc", "import", "react", "nextjs", "jsx-a11y", "vitest"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "error",
		"perf": "error"
	},
	"rules": {
		"typescript/no-explicit-any": "error",
		"typescript/consistent-type-imports": "error",
		"import/no-cycle": "error",
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		"react/react-in-jsx-scope": "off",
		// Pedantic rules turned off, one reason each.
		// Deep readonly types cannot be written for FormData, Request, Temporal or React props.
		"typescript/prefer-readonly-parameter-types": "off",
		// Rejects `onClick={() => setOpen(false)}`, the usual shape of a React handler.
		"typescript/no-confusing-void-expression": "off",
		// Fixed size caps; how large a module or component may be is a review decision.
		"eslint/max-lines": "off",
		"eslint/max-lines-per-function": "off",
		"import/max-dependencies": "off",
		// Results are unions; a test narrows one with `if (!result.ok) throw` before asserting on it.
		"vitest/no-conditional-in-test": "off",
		// Next.js server actions and cache() callbacks must be async even when they only return a promise.
		"eslint/require-await": "off",
		// tsc already rejects a missing return under a declared return type; the rule also rejects
		// exhaustive switches and React effects that return a cleanup on one path only.
		"typescript/consistent-return": "off",
		// Flags zod's `.catch()` as a promise chain; top-level await would also delay every importer.
		"unicorn/prefer-top-level-await": "off",
		// Times are Temporal values (ADR 0002). Better Auth hands out `Date` values, which only
		// `instantOf` in the session module turns into instants; no code makes a `Date` itself.
		"eslint/no-restricted-globals": [
			"error",
			{
				"name": "Date",
				"message": "Use Temporal (ADR 0002); convert a Better Auth time with instantOf."
			}
		],
		"oxc/no-accumulating-spread": "error",
		"anti-slop/no-array-filter-map": "error",
		"anti-slop/no-reduce-accumulator-copy": "error",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-readable-spacing": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"oxc/no-barrel-file": "error",
		"convenr/no-external-assets": "error",
		"convenr/no-spec-references": "error"
	},
	"jsPlugins": [
		{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
		{ "name": "convenr", "specifier": "./tools/oxlint/convenr/index.ts" }
	],
	"overrides": [
		{
			// A polyfill is imported for its side effect.
			"files": ["apps/web/src/instrumentation-client.ts", "apps/web/src/polyfills.generated.ts"],
			"rules": { "import/no-unassigned-import": "off" }
		},
		{
			// Client modules use zod/mini (jitless) so pages stay light and CSP-clean (ADR 0003, ADR 0013).
			"files": [
				"apps/web/src/components/**/*.{ts,tsx}",
				"apps/web/src/i18n/routing.ts",
				"apps/web/src/lib/local-events.ts",
				"apps/web/src/lib/event-version.ts",
				"apps/web/src/instrumentation-client.ts"
			],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "zod",
								"message": "Use \"zod/mini\" with z.config({ jitless: true }) in client code (ADR 0003, ADR 0013)."
							}
						]
					}
				]
			}
		}
	],
	"ignorePatterns": [
		"tools/oxlint/anti-slop/**",
		"**/.next/**",
		"**/dist/**",
		"**/coverage/**",
		"**/drizzle/**",
		"**/next-env.d.ts",
		"**/components/ui/**",
		"packages/sdk-ts/src/generated/**",
		".agents/**",
		".claude/**"
	]
}
